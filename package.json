{
  "name": "eslint-config-unjs",
  "version": "0.6.2",
  "description": "ESLint config for unjs projects",
  "repository": "unjs/eslint-config",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/eslint.config.mjs"
  },
  "types": "dist/eslint.config.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "eslint-config-inspector",
    "lint": "eslint . && prettier -c src",
    "format": "eslint . --fix && prettier -w src",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm build && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/markdown": "^7.5.1",
    "eslint-plugin-unicorn": "^68.0.0",
    "globals": "^17.1.0",
    "typescript-eslint": "^8.53.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^1.4.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.0.10",
    "@typescript/native-preview": "7.0.0-dev.20260122.4",
    "automd": "^0.4.2",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.2",
    "eslint-typegen": "^2.3.0",
    "obuild": "^0.4.20",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": "*",
    "typescript": "*"
  },
  "packageManager": "pnpm@10.28.1"
}
